# Safe paper/shadow defaults. Replace placeholders locally; never commit this file with secrets.
LIVE_TRADING=false
# Autonomous scanning is off until a strategy shows a positive backtest.
AUTONOMOUS_ENABLED=false
AUTONOMOUS_QUOTE_AMOUNT=25
AUTONOMOUS_MIN_CONFIDENCE=70
AUTONOMOUS_SCAN_SECONDS=300
AUTONOMOUS_TRADE_COOLDOWN_SECONDS=900
# Trade only when momentum clears MIN_EDGE_MULTIPLE round trips of cost.
TAKER_FEE_BPS=26
SLIPPAGE_BPS=2
MIN_EDGE_MULTIPLE=2.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
DAILY_LOSS_LIMIT=25
# Block entries while price is below its N-day average (halves drawdown).
TREND_FILTER_ENABLED=true
TREND_FILTER_DAYS=100
ML_ENABLED=false
ML_PAPER_MODE=true
ML_KILL_SWITCH=false
PAUSED=false
ENVIRONMENT=production
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_PAIR=XBTUSD
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
WEBHOOK_SECRET=change-me-locally
ML_MODEL_PATH=/var/lib/kraken-bot/models/ml_model.joblib
ML_CONFIDENCE_THRESHOLD=0.60
ML_MAX_ORDER_QUOTE=25
ML_MAX_POSITION_QUOTE=100
ML_DAILY_LOSS_LIMIT=25
