# Safe paper/shadow defaults. Replace placeholders locally; never commit this file with secrets.
LIVE_TRADING=false
PAPER_TRADING=true
EMERGENCY_STOP=false
ML_ENABLED=false
ML_PAPER_MODE=true
ML_KILL_SWITCH=false
PAUSED=false
ENVIRONMENT=production
ACTIVE_EXCHANGE=kraken

# Autonomous scan universe (comma-separated product ids)
SCAN_PAIRS=BTC-USD,ETH-USD,SOL-USD
SCAN_SECONDS=30
TRADE_COOLDOWN_SECONDS=60

# Kraken
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_PAIR=XBTUSD
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Coinbase Advanced Trade (CDP key pair; ES256 JWT per request)
COINBASE_ENABLED=false
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=
COINBASE_BASE_URL=https://api.coinbase.com

# LLM analysis providers (optional; local momentum fallback always available)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Ops
WEBHOOK_SECRET=change-me-locally
WEBHOOK_SIGNALS_ENABLED=true
WEBHOOK_DEFAULT_QUOTE=50
WEBHOOK_MIN_CONFIDENCE=0
ALERT_WEBHOOK_URL=
RECONCILE_EVERY_SCANS=20
ML_MODEL_PATH=/var/lib/kraken-bot/models/ml_model.joblib
ML_CONFIDENCE_THRESHOLD=0.60
ML_MAX_ORDER_QUOTE=200
ML_MAX_POSITION_QUOTE=500
ML_DAILY_LOSS_LIMIT=50
DATA_DIR=/var/lib/kraken-bot/data
LOG_DIR=/var/lib/kraken-bot/logs
MODEL_DIR=/var/lib/kraken-bot/models

# Risk / strategy tuning
STOP_LOSS_PERCENTAGE=2.0
TAKE_PROFIT_PERCENTAGE=3.0
TRAILING_STOP_PERCENTAGE=1.5
MAX_ORDER_QUOTE=200

# GCP market-data pipeline (optional; bot works without it)
GCP_PROJECT_ID=
BQ_FEATURES_ENABLED=false
BQ_DATASET=kraken_market
GCS_MODEL_URI=

# Ingest service (docker compose --profile ingest)
PUBSUB_CANDLES_TOPIC=market-candles
PUBSUB_TICKS_TOPIC=market-ticks
KRAKEN_PAIRS=BTC/USD,ETH/USD
COINBASE_PRODUCTS=BTC-USD,ETH-USD
INGEST_EXCHANGES=kraken
