# Safe paper/shadow defaults. Replace placeholders locally; never commit this file with secrets.
LIVE_TRADING=false
ML_ENABLED=false
ML_PAPER_MODE=true
ML_KILL_SWITCH=false
PAUSED=false
ENVIRONMENT=production
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_PAIR=XBTUSD
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
WEBHOOK_SECRET=change-me-locally
ML_MODEL_PATH=/var/lib/kraken-bot/models/ml_model.joblib
ML_CONFIDENCE_THRESHOLD=0.60
ML_MAX_ORDER_QUOTE=25
ML_MAX_POSITION_QUOTE=100
ML_DAILY_LOSS_LIMIT=25
